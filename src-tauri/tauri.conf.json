{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "haonote",
  "version": "0.1.5",
  "identifier": "app.qingnote.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "dragDropEnabled": false,
      "title": "haonote",
      "width": 1120,
      "height": 760,
      "minWidth": 760,
      "minHeight": 520,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/haohaomiao/haonote/releases/download/update-channel/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Productivity",
    "linux": { "deb": { "conflicts": ["qing-note"], "replaces": ["qing-note"] } },
    "shortDescription": "Offline-first sticky notes with WebDAV sync",
    "longDescription": "haonote is a simple sticky notes application. Write offline, pin notes on your desktop, and sync through your own WebDAV account.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "languages": ["SimpChinese", "English"], "displayLanguageSelector": false } }
  }
}
